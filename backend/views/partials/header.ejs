<header>
	<nav class="navbar navbar-expand-sm navbar-dark p-0 h-100">
		<div class="carousel-item">
			<img src="/assets/images/image.png" class="d-block w-100" alt="...">
		</div>
		<div class="container-fluid p-0">
			<a class="navbar-brand text-white ps-2" href="/">FoodConnect</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
				aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
				<span><i class="fas fa-bars text-white"></i></span>
			</button>
			<div class="collapse navbar-collapse ps-2" id="navbarSupportedContent" style="z-index: 100;">
				<ul class="navbar-nav ms-auto me-3">
					<li class="nav-item"><a class="nav-link" href="/home/about-us">About us</a></li>
					<li class="nav-item"><a class="nav-link" href="/home/mission">Our mission</a></li>
					<li class="nav-item"><a class="nav-link" href="/home/contact-us">Contact us</a></li>
					<% if(currentUser) { %>
						<script>window.currentUserId = "<%= currentUser ? currentUser._id : '' %>";</script>
						<li class="nav-item dropdown me-2">
							<a class="nav-link position-relative" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="fas fa-bell"></i>
								<span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none">0</span>
							</a>
							<ul class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="notifDropdown" style="min-width:300px;">
								<li><div id="notif-list" style="max-height:300px; overflow:auto; min-width:260px;">No notifications</div></li>
								<li><hr class="dropdown-divider"></li>
								<li><a class="dropdown-item text-center" href="#" id="mark-all-read">Mark all as read</a></li>
							</ul>
						</li>
						<li class="user-icon" id="user-icon" role="button" tabindex="0" aria-controls="sidebar" aria-expanded="false"><%= currentUser.firstName[0] %></li>
					<% } else { %>
						<li class="nav-item"><a class="nav-link" href="/auth/login">Login</a></li>
						<li class="nav-item"><a class="nav-link" href="/auth/signup">Signup</a></li>
					<% } %>
				</ul>
			</div>
		</div>
	</nav>
</header>