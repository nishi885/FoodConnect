<div class="m-0 pt-5 w-100 bg-img-1">
	<form action="/auth/verify" method="POST" class="w-50 bg-white p-5 m-auto" style="min-width: 320px;">
		<h3 class="text-center mb-3">Verify Your Email</h3>

		<div class="mb-3">
			<label for="email" class="form-label">Email address</label>
			<input type="email" class="form-control" id="email" readonly value="<%= typeof email != 'undefined' ? email : '' %>">
		</div>

		<div class="mb-3">
			<label for="otp" class="form-label">Verification Code</label>
			<input type="text" name="otp" class="form-control" id="otp" placeholder="Enter code.." required>
		</div>

		<button type="submit" class="btn d-block m-auto mt-4">Verify</button>
	</form>

	<div class="mt-3 text-center">
		<form action="/auth/resend-otp" method="POST" style="display:inline;">
			<button type="submit" class="btn btn-link">Resend code</button>
		</form>
	</div>
</div>
